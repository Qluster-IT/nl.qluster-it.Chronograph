					"id": "deep",
					"title": {
						"en": "Vivid",
						"nl": "Levendig"
					}
				}
			]
		},
		{
			"id": "layout",
			"type": "dropdown",
			"title": {
				"en": "Layout",
				"nl": "Indeling"
			},
			"value": "normal",
			"values": [
				{
					"id": "compact",
					"title": {
						"en": "Compact",
						"nl": "Compact"
					}
				},
				{
					"id": "normal",
					"title": {
						"en": "Normal",
						"nl": "Normaal"
					}
				},
				{
					"id": "large",
					"title": {
						"en": "Larger",
						"nl": "Groter"
					}
				}
			]
		},
