	"api": {
		"getTimers": {
			"method": "GET",
			"path": "/timers/"
		},
		"getTimer": {
			"method": "GET",
			"path": "/timers/:name"
		},
		"postTimer": {
			"method": "POST",
			"path": "/timers/"
		},
		"putTimer": {
			"method": "PUT",
			"path": "/timers/:name"
		},
		"deleteTimer": {
			"method": "DELETE",
			"path": "/timers/:name"
		},
		"getStopwatches": {
			"method": "GET",
			"path": "/stopwatches/"
		},
		"getStopwatch": {
			"method": "GET",
			"path": "/stopwatches/:name"
		},
		"postStopwatch": {
			"method": "POST",
			"path": "/stopwatches/"
		},
		"putStopwatch": {
			"method": "PUT",
			"path": "/stopwatches/:name"
		},
		"deleteStopwatch": {
			"method": "DELETE",
			"path": "/stopwatches/:name"
		},
		"getTransitions": {
			"method": "GET",
			"path": "/transitions/"
		},
		"getTransition": {
			"method": "GET",
			"path": "/transitions/:name"
		},
		"postTransition": {
			"method": "POST",
			"path": "/transitions/"
		},
		"putTransition": {
			"method": "PUT",
			"path": "/transitions/:name"
		},
		"deleteTransition": {
			"method": "DELETE",
			"path": "/transitions/:name"
		},
		"getChronographs": {
			"method": "GET",
			"path": "/chronographs/"
		},
		"getChronograph": {
			"method": "GET",
			"path": "/chronographs/:type/:name"
		},
		"putChronograph": {
			"method": "PUT",
			"path": "/chronographs/:type/:name"
		},
		"deleteChronograph": {
			"method": "DELETE",
			"path": "/chronographs/:type/:name"
		},
		"getAllChronographs": {
			"method": "GET",
			"path": "/allchronographs/"
