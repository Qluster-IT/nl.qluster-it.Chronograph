{
	"id": "nl.fellownet.chronograph",
	"version": "1.3.1",
	"compatibility": ">=5.0.0",
	"sdk": 3,
	"name": {
		"en": "Chronograph"
	},
	"description": {
		"en": "Adds precise timer, stopwatch and transition functionality to Homey.",
		"nl": "Voegt accurate timer, stopwatch en transitie functionaliteit toe aan Homey.",
		"de": "Fügt Homey präzise Timer, Stoppuhrfunktionen und Übergänge hinzu."
	},
	"brandColor": "#5583C3",
	"category": [
		"tools"
	],
	"tags": {
		"en": [
			"timer",
			"countdown",
			"stopwatch",
			"transitions",
			"chronograph",
			"hourglass"
		],
		"nl": [
			"timer",
			"countdown",
			"stopwatch",
			"transities",
			"chronograph",
			"zandloper"
		],
		"de": [
			"timer",
			"countdown",
			"stoppuhr",
			"übergänge",
			"chronograph",
			"sanduhr"
		]
	},
	"source": "https://bitbucket.org/QlusterIT/nl.qluster-it.chronograph/",
  	"bugs": {
		"url": "https://bitbucket.org/QlusterIT/nl.qluster-it.chronograph/issues"
	  },
	"homeyCommunityTopicId": 18214,
	"permissions": [],
	"images": {
		"large": "/assets/images/large.png",
		"small": "/assets/images/small.png"
	},
	"author": {
		"name": "Arie J. Godschalk",
		"email": "arie@qluster-it.nl"
	},
	"contributing": {
		"donate": {
			"paypal": {
				"username": "QlusterIT"
			}
		}
	},
	"contributors": {
		"developers": [
			{
				"name": "Bob Kersten",
				"email": "bob@fellownet.nl"
			},
			{
				"name": "Arie J. Godschalk",
				"email": "arie@qluster-it.nl"
			}
		]
	},
	"api": {
		"getTimers": {
			"method": "GET",
			"path": "/timers/"
		},
		"getTimer": {
			"method": "GET",
			"path": "/timers/:id"
		},
		"putTimer": {
			"method": "PUT",
			"path": "/timers/"
		},
		"deleteTimer": {
			"method": "DELETE",
			"path": "/timers/"
		},
		"getStopwatches": {
			"method": "GET",
			"path": "/stopwatches/"
		},
		"getStopwatch": {
			"method": "GET",
			"path": "/stopwatches/:id"
		},
		"putStopwatch": {
			"method": "PUT",
			"path": "/stopwatches/"
		},
		"deleteStopwatch": {
			"method": "DELETE",
			"path": "/stopwatches/"
		},
		"getTransitions": {
			"method": "GET",
			"path": "/transitions/"
		},
		"getTransition": {
			"method": "GET",
			"path": "/transitions/:id"
		},
		"putTransition": {
			"method": "PUT",
			"path": "/transitions/"
		},
		"deleteTransition": {
			"method": "DELETE",
			"path": "/transitions/"
		},
		"getChronographs": {
			"method": "GET",
			"path": "/chronographs/"
		},
		"getChronograph": {
			"method": "GET",
			"path": "/chronographs/:id"
		},
		"putChronograph": {
			"method": "PUT",
			"path": "/chronographs/"
		},
		"deleteChronograph": {
			"method": "DELETE",
			"path": "/chronographs/"
		}
	},
	"drivers": [
		{
			"id": "timer_driver",
			"name": {
				"en": "Timer"
			},
			"settings": [
				{
					"type": "group",
					"label": {
						"en": "Timer",
						"nl": "Timer"
					},
					"children": [
						{
							"id": "name",
							"type": "text",
							"label": {
								"en": "Name",
								"nl": "Naam"
							},
							"hint": {
								"en": "The name of the timer this device controls.",
								"nl": "De naam van de timer die door dit apparaat wordt bestuurd."
							}
						}
					]
				}
			],
			"images": {
				"large": "drivers/timer_driver/assets/images/large.png",
				"small": "drivers/timer_driver/assets/images/small.png"
			},
			"class": "sensor",
			"capabilities": [
				"alarm_running",
				"duration",
				"onoff.0"
			],
			"capabilitiesOptions": {
				"alarm_running": {
					"preventTag": true
				},
				"duration": {
					"preventTag": true
				},
				"onoff.0": {
					"title": {
						"en": "Start / Stop",
						"nl": "Starten / Stoppen"
					},
					"preventTag": true,
					"preventInsights": true
				}
			},
			"pair": [
				{
					"id": "list_devices",
					"template": "list_devices",
					"navigation": {
						"next": "add_devices"
					},
					"options": {
						"singular": true
					}
				},
				{
					"id": "add_devices",
					"template": "add_devices"
				}
			]
		},
		{
			"id": "stopwatch_driver",
			"name": {
				"en": "Stopwatch"
			},
			"settings": [
				{
					"type": "group",
					"label": {
						"en": "Timer",
						"nl": "Timer"
					},
					"children": [
						{
							"id": "name",
							"type": "text",
							"label": {
								"en": "Name",
								"nl": "Naam"
							},
							"hint": {
								"en": "The name of the stopwatch this device controls.",
								"nl": "De naam van de stopwatch die door dit apparaat wordt bestuurd."
							}
						}
					]
				}
			],
			"images": {
				"large": "drivers/stopwatch_driver/assets/images/large.png",
				"small": "drivers/stopwatch_driver/assets/images/small.png"
			},
			"class": "sensor",
			"capabilities": [
				"alarm_running",
				"duration",
				"onoff.0"
			],
			"capabilitiesOptions": {
				"alarm_running": {
					"preventTag": true
				},
				"duration": {
					"preventTag": true
				},
				"onoff.0": {
					"title": {
						"en": "Start / Stop",
						"nl": "Starten / Stoppen"
					},
					"preventTag": true,
					"preventInsights": true
				}
			},
			"pair": [
				{
					"id": "list_devices",
					"template": "list_devices",
					"navigation": {
						"next": "add_devices"
					},
					"options": {
						"singular": true
					}
				},
				{
					"id": "add_devices",
					"template": "add_devices"
				}
			]
		}
	]
}