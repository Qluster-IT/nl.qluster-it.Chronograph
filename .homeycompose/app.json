  "api": {
    "getTimers": {
      "method": "GET",
      "path": "/timers/"
    },
    "getTimer": {
      "method": "GET",
      "path": "/timers/:id"
    },
    "putTimer": {
      "method": "PUT",
      "path": "/timers/:id"
    },
    "deleteTimer": {
      "method": "DELETE",
      "path": "/timers/:id"
    },
    "getStopwatches": {
      "method": "GET",
      "path": "/stopwatches/"
    },
    "getStopwatch": {
      "method": "GET",
      "path": "/stopwatches/:id"
    },
    "putStopwatch": {
      "method": "PUT",
      "path": "/stopwatches/:id"
    },
    "deleteStopwatch": {
      "method": "DELETE",
      "path": "/stopwatches/:id"
    },
    "getTransitions": {
      "method": "GET",
      "path": "/transitions/"
    },
    "getTransition": {
      "method": "GET",
      "path": "/transitions/:id"
    },
    "putTransition": {
      "method": "PUT",
      "path": "/transitions/:id"
    },
    "deleteTransition": {
      "method": "DELETE",
      "path": "/transitions/:id"
    },
    "getChronographs": {
      "method": "GET",
      "path": "/chronographs/"
    },
    "getChronograph": {
      "method": "GET",
      "path": "/chronographs/:id"
    },
    "putChronograph": {
      "method": "PUT",
      "path": "/chronographs/:id"
    },
    "deleteChronograph": {
      "method": "DELETE",
      "path": "/chronographs/:id"
    },
    "getAllChronographs": {
      "method": "GET",
      "path": "/allchronographs/"
    }
  }
}